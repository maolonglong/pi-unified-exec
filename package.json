{
  "name": "pi-unified-exec-workspace",
  "version": "0.1.7",
  "private": true,
  "homepage": "https://github.com/maolonglong/pi-unified-exec#readme",
  "bugs": {
    "url": "https://github.com/maolonglong/pi-unified-exec/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maolonglong/pi-unified-exec.git"
  },
  "workspaces": [
    "packages/persistent-exec-node",
    "packages/persistent-exec-bun",
    "packages/pi-unified-exec"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "node --test scripts/*.test.mjs && npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor"
  },
  "devDependencies": {
    "oxfmt": "^0.64.0"
  }
}
