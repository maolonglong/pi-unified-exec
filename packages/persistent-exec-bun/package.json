{
  "name": "persistent-exec-bun",
  "version": "0.1.7",
  "description": "Bun FFI bindings for the persistent-exec native runtime",
  "homepage": "https://github.com/maolonglong/pi-unified-exec#readme",
  "bugs": {
    "url": "https://github.com/maolonglong/pi-unified-exec/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maolonglong/pi-unified-exec.git",
    "directory": "packages/persistent-exec-bun"
  },
  "files": [
    "src",
    "dist",
    "NOTICE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prepack": "node ../../scripts/stage-package-metadata.mjs persistent-exec-bun",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "bun build src/index.ts --format=esm --target=bun --outdir dist && tsc -p tsconfig.build.json",
    "test": "bun test test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "typescript": "^5.9.0"
  },
  "optionalDependencies": {
    "persistent-exec-bin-darwin-arm64": "0.1.7",
    "persistent-exec-bin-darwin-x64": "0.1.7",
    "persistent-exec-bin-linux-arm64-gnu": "0.1.7",
    "persistent-exec-bin-linux-arm64-musl": "0.1.7",
    "persistent-exec-bin-linux-x64-gnu": "0.1.7",
    "persistent-exec-bin-linux-x64-musl": "0.1.7",
    "persistent-exec-bin-win32-arm64": "0.1.7",
    "persistent-exec-bin-win32-x64": "0.1.7"
  }
}
