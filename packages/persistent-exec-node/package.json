{
  "name": "persistent-exec-node",
  "version": "0.1.7",
  "description": "Node.js FFI bindings for the persistent-exec native runtime",
  "homepage": "https://github.com/maolonglong/pi-unified-exec#readme",
  "bugs": {
    "url": "https://github.com/maolonglong/pi-unified-exec/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maolonglong/pi-unified-exec.git",
    "directory": "packages/persistent-exec-node"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prepack": "node ../../scripts/stage-package-metadata.mjs persistent-exec-node",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsup src/index.ts --format esm --platform node --target node20 --external ffi-rs --dts",
    "test": "npm run build && node test/e2e.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ffi-rs": "^1.3.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0"
  },
  "optionalDependencies": {
    "persistent-exec-bin-darwin-arm64": "0.1.7",
    "persistent-exec-bin-darwin-x64": "0.1.7",
    "persistent-exec-bin-linux-arm64-gnu": "0.1.7",
    "persistent-exec-bin-linux-arm64-musl": "0.1.7",
    "persistent-exec-bin-linux-x64-gnu": "0.1.7",
    "persistent-exec-bin-linux-x64-musl": "0.1.7",
    "persistent-exec-bin-win32-arm64": "0.1.7",
    "persistent-exec-bin-win32-x64": "0.1.7"
  }
}
