{
  "name": "@chensl/pi-unified-exec",
  "version": "0.1.7",
  "description": "Codex-style unified_exec for pi: long-running shell sessions the model polls and drives with write_stdin (PTY, REPLs, ssh, dev servers, Ctrl-C)",
  "keywords": [
    "codex",
    "persistent-exec",
    "pi",
    "pi-extension",
    "pi-package",
    "pty",
    "repl",
    "shell",
    "terminal",
    "unified-exec"
  ],
  "homepage": "https://github.com/maolonglong/pi-unified-exec#readme",
  "bugs": {
    "url": "https://github.com/maolonglong/pi-unified-exec/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maolonglong/pi-unified-exec.git",
    "directory": "packages/pi-unified-exec"
  },
  "files": [
    "src",
    "NOTICE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node ../../scripts/stage-package-metadata.mjs pi-unified-exec",
    "test": "bun test test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "persistent-exec-bun": "0.1.7",
    "persistent-exec-node": "0.1.7"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/bun": "^1.3.8",
    "@types/node": "^24.0.0",
    "typebox": "^1.0.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
